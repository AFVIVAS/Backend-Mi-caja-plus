# Copiar a .env y completar. El archivo .env NO se versiona.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=Micajaplus

# Flask: clave larga y aleatoria, p. ej. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Orígenes del front permitidos por CORS, separados por coma
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Cookie de sesión. Si el front está en otro sitio y usa HTTPS: SESSION_COOKIE_SAMESITE=None y SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0

# Servidor de desarrollo
HOST=0.0.0.0
PORT=4000
FLASK_DEBUG=0
